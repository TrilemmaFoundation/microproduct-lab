{
  "name": "microproduct-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Build Trilemma — open knowledge hub for microproducts (Docusaurus)",
  "scripts": {
    "predev": "node scripts/clear-dev-cache.mjs && node scripts/generate-agent-docs.mjs",
    "dev": "docusaurus start",
    "start": "npm run dev",
    "build": "node scripts/generate-agent-docs.mjs && node scripts/generate-llms-full.mjs && docusaurus build && node scripts/validate-build-artifacts.mjs",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "clean": "docusaurus clear && rm -rf build coverage",
    "typecheck": "tsc --noEmit",
    "validate:frontmatter": "node scripts/validate-frontmatter.mjs",
    "validate:registry": "node scripts/validate-registry.mjs",
    "validate:playbook": "node scripts/validate-playbook-tree.mjs",
    "lint:markdown": "markdownlint \"docs/**/*.md\" \"docs/**/*.mdx\" \"README.md\" \"CONTRIBUTING.md\" \"CODE_OF_CONDUCT.md\" \"templates/**/*.md\" \"product-templates/**/*.md\" \"products/**/*.md\" --ignore \"docs/agents/human/**\"",
    "spellcheck": "cspell \"docs/**\" \"product-templates/**\" \"templates/**/*.md\"",
    "check": "npm run typecheck && npm run spellcheck && npm run validate:frontmatter && npm run validate:registry && npm run validate:playbook && npm run lint:markdown && npm run build",
    "test:scripts": "node --test scripts/__tests__/*.test.mjs",
    "test:scripts:coverage": "node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-include='scripts/*.mjs' --test-coverage-exclude=scripts/clear-dev-cache.mjs --test-coverage-exclude=scripts/generate-llms-full.mjs scripts/__tests__/*.test.mjs",
    "test": "jest && npm run test:scripts",
    "test:coverage": "jest --coverage && npm run test:scripts:coverage"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/faster": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-mermaid": "^3.10.2",
    "@mermaid-js/layout-elk": "^0.1.9",
    "clsx": "^2.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cspell": "^10.0.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "js-yaml": "^5.2.1",
    "markdownlint-cli": "^0.49.1",
    "ts-jest": "^29.4.11",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "serialize-javascript": "^7.0.0",
    "@tootallnate/once": "^3.0.1",
    "sockjs": {
      "uuid": "11.1.1"
    },
    "websocket-driver": "^0.7.5"
  },
  "engines": {
    "node": "22.x"
  }
}
